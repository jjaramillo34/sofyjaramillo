# Copy to .env.local for local development; set the same keys in Vercel (vercel env add).

# Public URL, used for canonical/alternate links and the Open Graph share image.
# On Vercel it falls back to the production domain when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB Atlas: commission requests are stored in <db>.commission_requests
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=sofy-studio

# Notifications (each channel optional; requests are saved either way)
RESEND_API_KEY=
COMMISSION_NOTIFY_EMAIL=family@example.com
# Must be on a domain verified in Resend; the default sandbox sender only delivers to your own account.
COMMISSION_FROM_EMAIL="Sofy Studio <studio@your-domain.com>"
# Slack/Discord/Zapier/Make incoming webhook (receives JSON with `text`, `content` and `commission`)
COMMISSION_WEBHOOK_URL=

# Vercel Blob, for reference images attached to commission requests (created automatically
# when you connect a Blob store to the Vercel project). Without it, images are skipped.
BLOB_READ_WRITE_TOKEN=

# Keystatic: leave empty for local mode (edit at http://localhost:3000/keystatic).
# Set to owner/repo to edit content through GitHub in production; Keystatic's
# setup wizard then creates the KEYSTATIC_GITHUB_CLIENT_ID / _SECRET / KEYSTATIC_SECRET values.
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=

# Optional: secret used to hash visitor IPs for the like rate limit (any random string).
LIKES_SALT=
